<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cybersecurity Awareness Bot" 
        Height="700" 
        Width="900"
        Background="#0a0e27"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00d4aa"/>
            <Setter Property="Foreground" Value="#0a0e27"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00b894"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1a1f4b"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#00d4aa"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CaretBrush" Value="#00d4aa"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="#0d1235" 
                BorderBrush="#00d4aa" 
                BorderThickness="0,0,0,2" 
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="AsciiArtTextBlock"
                               FontFamily="Consolas"
                               Foreground="#00d4aa"
                               FontSize="11"
                               TextWrapping="NoWrap"
                               LineHeight="14"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="CYBERSECURITY AWARENESS ASSISTANT v2.0"
                               Foreground="#ffffff"
                               FontSize="16"
                               FontWeight="Bold"
                               FontFamily="Segoe UI"/>

                    <TextBlock Text="Keeping South Africa Safe Online"
                               Foreground="#00d4aa"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" 
                        Background="#1a1f4b" 
                        CornerRadius="5" 
                        Padding="10,5" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" 
                                 Height="10" 
                                 Fill="#00d4aa" 
                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Online" 
                                   Foreground="#00d4aa" 
                                   FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
                Background="#0a0e27" 
                Margin="10" 
                CornerRadius="5">
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          Margin="5">
                <StackPanel x:Name="ChatStackPanel" 
                            Margin="10"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" 
                Background="#0d1235" 
                BorderBrush="#00d4aa" 
                BorderThickness="0,2,0,0" 
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="UserInputTextBox"
                         Grid.Column="0"
                         Style="{StaticResource InputTextBoxStyle}"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInputTextBox_KeyDown"
                         Text="Type your message here..."/>

                <Button x:Name="SendButton"
                        Grid.Column="1"
                        Style="{StaticResource SendButtonStyle}"
                        Content="SEND"
                        Margin="10,0,0,0"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>